{
  "name": "@drs/mcp-server",
  "version": "0.1.0",
  "description": "DRS enforcement point for MCP, A2A and HTTP tool servers \u2014 a thin client of drs-verify POST /v1/gate",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OkeyAmy/DRS",
    "directory": "packages/drs-mcp-server"
  },
  "keywords": [
    "drs",
    "mcp",
    "server",
    "middleware",
    "verification"
  ],
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
